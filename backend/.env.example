# Copy to `.env` and fill in real values. NEVER commit a real .env.
# The backend reads these from the environment (docker-compose passes them in).

# --- Gemini embeddings -------------------------------------------------------
# Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key
# Optional overrides (defaults shown). Model + dim MUST agree with the
# vector(N) column in app/storage/schema.sql.
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
EMBEDDING_BATCH_SIZE=100

# --- Database (Supabase Postgres or local pgvector) --------------------------
# Preferred: a direct Postgres connection string used by psycopg.
# Local docker-compose:  postgresql://codex:codex@db:5432/codex
# Supabase (hosted):     postgresql://postgres:<password>@db.<ref>.supabase.co:5432/postgres
DATABASE_URL=postgresql://codex:codex@db:5432/codex

# Supabase project details (used if/when you talk to Supabase's REST/JS APIs;
# the Stage-2 backend connects via DATABASE_URL above, but these are listed for
# completeness and future stages).
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-key
